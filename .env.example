API_PORT=8000
MODEL_SERVER_PORT=8001
CHATBOT_PORT=8501
WIDGET_PORT=5173
HOST_PORT=8080

API_APP_NAME=maintainers-copilot-api
API_ENV=development
API_LOG_LEVEL=INFO
API_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/maintainers_copilot
API_REQUIRE_VAULT=true
API_VAULT_ADDR=http://vault:8200
API_VAULT_TOKEN=dev-root-token
API_REDIS_URL=redis://redis:6379/0
API_MINIO_ENDPOINT=minio:9000
API_MINIO_ACCESS_KEY=minioadmin
API_MINIO_SECRET_KEY=minioadmin
API_MINIO_BUCKET=maintainers-copilot
API_MODEL_SERVER_URL=http://model-server:8001

MODEL_SERVER_APP_NAME=maintainers-copilot-model-server
MODEL_SERVER_LOG_LEVEL=INFO
MODEL_SERVER_ARTIFACT_DIR=/app/artifacts/classifier

POSTGRES_DB=maintainers_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

VAULT_DEV_ROOT_TOKEN_ID=dev-root-token

