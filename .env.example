API_PORT=8000
MODEL_SERVER_PORT=8001
CHATBOT_PORT=8501
WIDGET_PORT=5173
HOST_PORT=8080

API_APP_NAME=maintainers-copilot-api
API_ENV=development
API_LOG_LEVEL=INFO
API_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/maintainers_copilot
API_REQUIRE_VAULT=true
API_VAULT_ADDR=http://vault:8200
API_VAULT_TOKEN=dev-root-token
API_JWT_SECRET_PATH=secret/data/maintainers-copilot/api
API_DB_PASSWORD_SECRET_PATH=secret/data/maintainers-copilot/postgres
API_MINIO_ACCESS_KEY_SECRET_PATH=secret/data/maintainers-copilot/minio
API_MINIO_SECRET_KEY_SECRET_PATH=secret/data/maintainers-copilot/minio
API_REDIS_URL=redis://redis:6379/0
API_MINIO_ENDPOINT=minio:9000
API_MINIO_ACCESS_KEY=minioadmin
API_MINIO_SECRET_KEY=minioadmin
API_MINIO_BUCKET=maintainers-copilot
API_MODEL_SERVER_URL=http://model-server:8001
API_JWT_SECRET=dev-only-jwt-secret-change-me
API_JWT_EXP_MINUTES=60
API_INVITE_EXP_HOURS=72
API_ANTHROPIC_MODEL_NAME=claude-haiku-4-5-20251001
API_ANTHROPIC_API_KEY_SECRET_PATH=secret/data/maintainers-copilot/anthropic
API_REQUIRE_LLM_KEY=false
API_REQUIRE_MODEL_SERVER_HEALTH=false
API_REQUIRE_TRACING=false
API_TRACING_BACKEND_URL=
API_OTEL_EXPORTER_ENDPOINT=http://jaeger:4317
API_VALIDATE_EVAL_THRESHOLDS=true
API_MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
API_MEMORY_EMBEDDING_DIMENSION=384
API_REQUIRE_MEMORY_VECTOR=false
API_ALLOW_MEMORY_TEXT_FALLBACK=true
API_RAG_CORPUS_PATH=data/rag/processed/rag_corpus.jsonl
API_RAG_EMBEDDING_INDEX_DIR=artifacts/rag/embeddings
API_RAG_RERANKER_MODEL_PATH=artifacts/rag/reranker_model
API_RAG_RERANK_TOP_N=20
API_CHAT_LLM_ENABLED=true
API_CHAT_FALLBACK_ENABLED=true
API_CHAT_ALLOW_ENV_KEY_FALLBACK=false
API_AUTH_OPTIONAL_FOR_DEV=false
API_RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_BACKEND=redis
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_CHAT_MAX_REQUESTS=30
API_RATE_LIMIT_WIDGET_MAX_REQUESTS=60
API_RATE_LIMIT_FAIL_OPEN=true
API_SHORT_TERM_MEMORY_TTL_SECONDS=7200
API_ALLOW_IN_MEMORY_MEMORY=false
API_ENABLE_DEMO_WIDGET_FALLBACK=false

MODEL_SERVER_APP_NAME=maintainers-copilot-model-server
MODEL_SERVER_LOG_LEVEL=INFO
MODEL_SERVER_ARTIFACT_DIR=/app/artifacts/classifier

POSTGRES_DB=maintainers_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

VAULT_DEV_ROOT_TOKEN_ID=dev-root-token
